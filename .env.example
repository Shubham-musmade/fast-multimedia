# ==================== FastAPI ====================
DEBUG=true
PROJECT_NAME=Media Service

# ==================== Database ====================
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/media_db

# ==================== JWT (from Django) ====================
JWT_SECRET_KEY=your_django_jwt_secret_key_here
JWT_ALGORITHM=HS256

# ==================== Google Cloud Storage ====================
GCS_BUCKET_NAME=your-media-bucket-name
GCS_PROJECT_ID=your-gcp-project-id

# ==================== Application Limits ====================
MAX_UPLOAD_SIZE_MB=50
DAILY_UPLOAD_LIMIT=3

# Optional: Logging
LOG_LEVEL=INFO